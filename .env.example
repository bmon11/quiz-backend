# MongoDB Atlas connection string. Put the database name ("quiz") in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quiz?retryWrites=true&w=majority
PORT=4010
# Comma-separated list of allowed browser origins (the Next.js web app).
CORS_ORIGINS=http://localhost:3040

# Gemini (content generator only). Vertex AI with local ADC, or set GEMINI_API_KEY with GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Accounts. JWT_SECRET signs login tokens (required in production: `openssl rand -hex 32`).
JWT_SECRET=
# Google sign-in: OAuth 2.0 Web client id (Google Cloud console → Credentials). Same value as the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Comma-separated emails that get the admin page (add categories, lessons, questions).
ADMIN_EMAILS=
