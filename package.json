{
  "name": "quiz-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API for the Quiz app — topics, visual lessons, questions, answer stats",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:prod": "node dist/scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:memory": "ts-node src/scripts/devMemory.ts",
    "generate": "ts-node src/scripts/generate.ts",
    "categorize": "ts-node src/scripts/categorize.ts",
    "expand": "ts-node src/scripts/expand.ts",
    "images": "ts-node src/scripts/images.ts",
    "place-facts": "ts-node src/scripts/place-facts.ts",
    "import:doc": "ts-node src/scripts/import-doc.ts",
    "maps": "ts-node src/scripts/maps.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "mongoose": "^8.16.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/supertest": "^7.2.1",
    "mapshaper": "^0.6.121",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
